[sub_resource type="Resource" id="Resource_yk8p0"]
script = ExtResource("9_51nrr")
text = "You actually did it!

The bridge is standing again.

Looks like I can finally continue my journey."
metadata/_custom_type_script = "uid://opgri4swc804"

