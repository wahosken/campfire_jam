[sub_resource type="Resource" id="Resource_56ksa"]
script = ExtResource("9_51nrr")
text = "Oh! A traveler.

I was headed for the village when the bridge gave out.

Been stuck on this side ever since."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_l580g"]
script = ExtResource("10_jqmpd")
lines = Array[ExtResource("9_51nrr")]([SubResource("Resource_56ksa")])
metadata/_custom_type_script = "uid://dp0aobj5pqnj3"

[sub_resource type="Resource" id="Resource_51nrr"]
script = ExtResource("9_51nrr")
text = "Thanks again for your help.

Since we're both headed to the village, why don't we make some music together?"
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_jqmpd"]
script = ExtResource("10_jqmpd")
lines = Array[ExtResource("9_51nrr")]([SubResource("Resource_51nrr")])
metadata/_custom_type_script = "uid://dp0aobj5pqnj3"

[sub_resource type="Resource" id="Resource_dmog3"]
script = ExtResource("9_51nrr")
text = "Funny thing is, people around here say music can wake old things up.

If you can get that bridge working again, I'd finally be able to make it across."
metadata/_custom_type_script = "uid://opgri4swc804"

