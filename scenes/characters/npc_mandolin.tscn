[sub_resource type="Resource" id="Resource_pkf02"]
script = ExtResource("9_fiknp")
text = "Isn't this fountain beautiful?

It used to sing along with the musicians who gathered here.

These days it's gone quiet."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_c5ui3"]
script = ExtResource("10_6auh4")
lines = Array[ExtResource("9_fiknp")]([SubResource("Resource_pkf02")])
metadata/_custom_type_script = "uid://dp0aobj5pqnj3"

[sub_resource type="Resource" id="Resource_fiknp"]
script = ExtResource("9_fiknp")
text = "Music has a way of bringing places back to life.

Let me know if you'd like to play together.

I'd love to play together sometime."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_sjxf6"]
script = ExtResource("10_6auh4")
lines = Array[ExtResource("9_fiknp")]([SubResource("Resource_fiknp")])
metadata/_custom_type_script = "uid://dp0aobj5pqnj3"

[sub_resource type="Resource" id="Resource_tx3q8"]
script = ExtResource("9_fiknp")
text = "Maybe it just needs someone willing to play.

Try making a little music by the fountain and see what happens."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_7v0tl"]
