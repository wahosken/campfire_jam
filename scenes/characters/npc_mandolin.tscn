[sub_resource type="Resource" id="Resource_6auh4"]
script = ExtResource("9_fiknp")
text = "Listen to that!

The fountain's singing again.

I knew it still remembered the old melodies."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_7neta"]
script = ExtResource("10_6auh4")
