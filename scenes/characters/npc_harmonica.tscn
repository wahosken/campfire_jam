[sub_resource type="Resource" id="Resource_mxouj"]
script = ExtResource("9_xemgl")
text = "Much better.

A drink and a good tune can fix just about anything.

Let's make some music."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_xlnwc"]
