[sub_resource type="Resource" id="Resource_0tbxj"]
script = ExtResource("9_xemgl")
text = "Whew...

I've been wandering these paths all morning.

Starting to regret not packing a drink."
metadata/_custom_type_script = "uid://opgri4swc804"

[sub_resource type="Resource" id="Resource_jxr2l"]
